// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = PrestoTestApp
PRODUCT_DISPLAY_NAME = Presto E2E
PRODUCT_BUNDLE_IDENTIFIER = com.presto.fixture
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2 

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_EXPAND_BUILD_SETTINGS = YES
FIXTURE_VERSION = BASE

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/PrestoTestApp.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/PrestoTestApp.entitlements
